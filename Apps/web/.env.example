# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_MODE=dev
DEV_USER_ID=

# Data (defaults match Devops/docker/docker-compose.yml)
DATABASE_URL=postgresql://booking:booking_dev@localhost:5432/booking_meeting
REDIS_URL=redis://localhost:6379

# Booking policy
BOOKING_MIN_LEAD_MINUTES=15
BOOKING_CANCEL_WINDOW_HOURS=2

# Auth.js / OIDC (production)
AUTH_SECRET=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Email (optional in dev — worker logs preview)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@example.com
