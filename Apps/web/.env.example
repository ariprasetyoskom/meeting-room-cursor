# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Auth: dev (local UUID header) | oidc (SSO)
AUTH_MODE=dev
DEV_USER_ID=

# Required when AUTH_MODE=oidc; optional in dev (middleware fallback if empty)
AUTH_SECRET=dev-auth-secret-min-32-chars-long!!

# Generic OIDC (Azure AD, Keycloak, Okta, etc.)
OIDC_ISSUER=https://login.microsoftonline.com/{tenant-id}/v2.0
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPE=openid email profile
OIDC_PROVIDER_NAME=Corporate SSO

# Data (defaults match Devops/docker/docker-compose.yml)
DATABASE_URL=postgresql://booking:booking_dev@127.0.0.1:5434/booking_meeting
REDIS_URL=redis://localhost:6379

# Booking policy
BOOKING_MIN_LEAD_MINUTES=15
BOOKING_CANCEL_WINDOW_HOURS=2

# Email (optional in dev — worker logs preview)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@example.com
