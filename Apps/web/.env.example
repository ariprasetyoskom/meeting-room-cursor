# App (employee portal) + admin portal (dev: port terpisah → sesi localStorage tidak bentrok)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_PORTAL_URL=http://localhost:3001

# Auth: dev (local UUID header) | oidc (SSO)
AUTH_MODE=dev
DEV_USER_ID=
# Opsional: default dev user di npm run dev:admin (dari output db:seed ADMIN_DEV_USER_ID)
ADMIN_DEV_USER_ID=

# Required when AUTH_MODE=oidc; optional in dev (middleware fallback if empty)
AUTH_SECRET=dev-auth-secret-min-32-chars-long!!

# Generic OIDC (Azure AD, Keycloak, Okta, etc.)
OIDC_ISSUER=https://login.microsoftonline.com/{tenant-id}/v2.0
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPE=openid email profile
OIDC_PROVIDER_NAME=Corporate SSO

# Data (defaults match Devops/docker/docker-compose.yml)
DATABASE_URL=postgresql://booking:booking_dev@127.0.0.1:5434/booking_meeting
REDIS_URL=redis://localhost:6379

# Booking policy
BOOKING_MIN_LEAD_MINUTES=15
BOOKING_CANCEL_WINDOW_HOURS=2

# Email (optional in dev — worker logs preview)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@example.com

# GitHub Project scheduler admin UI (/admin/scheduler) — PAT: repo + Actions variables
GH_SCHEDULER_ADMIN_TOKEN=
GITHUB_REPO_OWNER=ariprasetyoskom
GITHUB_REPO_NAME=meeting-room-cursor

# Log terpusat KAD/ORCH (default: <repo>/Development/logs)
# DEVELOPMENT_LOG_DIR=

# Kanban → Cursor Automation (PRD KAD) — geser ke Development/Test di /admin/board
BOARD_AGENT_DISPATCH_ENABLED=false
# Set false untuk menonaktifkan dispatch Test otomatis setelah Development selesai
# BOARD_AUTO_DISPATCH_TEST=false
# Set false untuk menonaktifkan dispatch Audit otomatis setelah Test selesai
# BOARD_AUTO_DISPATCH_AUDIT=false
CURSOR_AUTOMATION_WEBHOOK_URL=
CURSOR_AUTOMATION_WEBHOOK_SECRET=
GH_DISPATCH_PAT=
# GITHUB_DISPATCH_REPO=ariprasetyoskom/meeting-room-cursor
# BOARD_DISPATCH_LOCK_TTL_MS=14400000
